# 画面と静的ファイルに付けるセキュリティのヘッダー（Void がデプロイのときに読む）。
# - CSP：スクリプトは自分のオリジンだけ。写真は R2、通信は R2 と MoQ Relay、フォントは Google Fonts に限る。
#   style の 'unsafe-inline' は、React の style 属性と Motion が差し込む <style> のため。
#   worker の blob: は、canvas-confetti が紙吹雪を Worker で描くため。
# - iframe に入れさせない（frame-ancestors 'none'）。部屋の番号が入った URL を、ほかのサイトへ Referer で渡さない。
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob: https://4723b654d7c87a32f3a5b3e260da5eec.r2.cloudflarestorage.com; connect-src 'self' https://4723b654d7c87a32f3a5b3e260da5eec.r2.cloudflarestorage.com https://draft-16.cloudflare.mediaoverquic.com wss://draft-16.cloudflare.mediaoverquic.com; worker-src 'self' blob:; media-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin
