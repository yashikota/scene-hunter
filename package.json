{
  "name": "scene-hunter",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/client/paraglide",
    "pretest": "pnpm i18n:compile",
    "test": "vp test run",
    "pree2e": "pnpm i18n:compile",
    "e2e": "playwright test",
    "e2e:prod": "playwright test -c playwright.prod.config.ts",
    "pretypecheck": "pnpm i18n:compile",
    "typecheck": "void prepare && tsc --noEmit",
    "lint": "vp lint",
    "deploy:settings": "node scripts/apply-script-settings.mjs",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check"
  },
  "dependencies": {
    "canvas-confetti": "1.9.4",
    "motion": "13.5.1"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.29.0",
    "@moq/net": "0.4.3",
    "@playwright/test": "^1.64.1",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/router-plugin": "^1.168.46",
    "@testing-library/react": "^16.3.3",
    "@types/canvas-confetti": "1.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "aws4fetch": "^1.0.20",
    "happy-dom": "^20.14.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "valibot": "^1.5.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@^1.3.0",
    "vite-plus": "^1.3.0",
    "void": "^1.1.11"
  },
  "packageManager": "pnpm@12.10.1"
}
